FROM --platform=linux/amd64 python:3.11-slim-bookworm AS builder
WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-cache --no-install-project --extra cpu

FROM --platform=linux/amd64 python:3.11-slim-bookworm
WORKDIR /app

COPY --from=builder /app /app
COPY src /app/src

# Create cache directories
RUN mkdir -p /root/.cache/huggingface /root/.EasyOCR

# Set environment variables
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV EASYOCR_CACHE=/root/.EasyOCR
ENV PORT=8080

# Install gsutil for bucket sync
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    && curl -sSL https://sdk.cloud.google.com | bash \
    && rm -rf /var/lib/apt/lists/*

# Add gcloud to PATH
ENV PATH="/root/google-cloud-sdk/bin:$PATH"

CMD [ "/app/.venv/bin/python", "-m", "src.main" ]
