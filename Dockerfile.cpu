FROM python:3.11-slim-bookworm AS builder
WORKDIR /app

# Install uv from a prebuilt container
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/

# Copy Python project files
COPY pyproject.toml uv.lock /app/

# Create a virtual environment and install dependencies into it
RUN python -m venv /app/.venv && \
    /app/.venv/bin/pip install --upgrade pip && \
    uv sync --frozen --no-cache --no-install-project --extra cpu

# --- Runtime Image ---
FROM python:3.11-slim-bookworm
WORKDIR /app

# Copy application code
COPY --from=builder /app /app
COPY src/ /app/src/

# Create Huggingface and EasyOCR cache folders
RUN mkdir -p /root/.cache/huggingface /root/.EasyOCR

# Environment variables
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV EASYOCR_CACHE=/root/.EasyOCR
ENV PORT=8080
ENV CACHE_BUCKET=docling-models
ENV LOG_LEVEL=DEBUG
ENV PYTHONPATH=/app

# Activate virtual environment and run the app
CMD ["/app/.venv/bin/python", "-m", "src.main"]
