FROM python:3.11-slim-bookworm

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY pyproject.toml README.md /app/
COPY src/ /app/src/
COPY start.sh /app/start.sh

# Create virtual environment and install dependencies
RUN python -m venv .venv && \
    . .venv/bin/activate && \
    pip install -e .[cpu]

# Create cache directories
RUN mkdir -p /root/.cache/huggingface /root/.EasyOCR

# Set environment variables
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV EASYOCR_CACHE=/root/.EasyOCR
ENV PORT=8080
ENV CACHE_BUCKET=docling-models
ENV AUTH_TOKEN=docling-inference-token
ENV LOG_LEVEL=DEBUG
ENV PYTHONPATH=/app

# Make start script executable and ensure it uses the correct shell
RUN chmod +x /app/start.sh && \
    dos2unix /app/start.sh

# Add health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["/bin/sh", "/app/start.sh"]
